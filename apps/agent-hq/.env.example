# Optional AI runtime. Running a team sends the request and recent shared notes
# to the configured OpenAI API. API use may be billed to your API account.
OPENAI_API_KEY=
OPENAI_MODEL=

# Hosted deployments require both values. Use a unique password (14+ chars)
# and a randomly generated signing secret (32+ chars). Never commit real values.
AGENT_HQ_ADMIN_PASSWORD=
AGENT_HQ_SESSION_SECRET=
AGENT_HQ_REQUIRE_AUTH=0

# All WhatsApp values are blank by default. Sending remains disabled until configured.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Comma-separated international phone digits for recipients who opted in.
WHATSAPP_ALLOWED_RECIPIENTS=

# Optional absolute path for the SQLite database. Default: ./data/agent-hq.sqlite3
# AGENT_HQ_DB=
# Optional server bind host. Keep the default loopback for local private use.
# AGENT_HQ_HOST=127.0.0.1
