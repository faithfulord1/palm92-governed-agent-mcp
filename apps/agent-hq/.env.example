# All WhatsApp values are blank by default. Sending remains disabled until configured.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Comma-separated international phone digits for explicitly consented recipients.
WHATSAPP_ALLOWED_RECIPIENTS=

# Optional absolute path for the SQLite database. Default: ./data/agent-hq.sqlite3
# AGENT_HQ_DB=
